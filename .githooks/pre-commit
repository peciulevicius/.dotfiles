#!/bin/bash
# Block commits that contain secrets. This repo is PUBLIC.
#
# Enabled per clone by: git config core.hooksPath .githooks
# (install.sh does this on new machines.)
#
# Why a hook and not "remember to check": a real token reached this repo in
# plain sight (rclone-backup.sh, found 2026-09-23). A hook runs every time,
# including for commits made by hand or from another machine's editor.

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "⚠️  gitleaks not installed — secret scan SKIPPED. brew install gitleaks" >&2
  exit 0
fi

if ! gitleaks git --pre-commit --staged --redact --no-banner --verbose \
     --config "$(git rev-parse --show-toplevel)/.gitleaks.toml"; then
  echo "" >&2
  echo "🚫 Commit blocked: gitleaks found a possible secret in the staged changes." >&2
  echo "   Move the value into a gitignored .env and reference it instead." >&2
  echo "   False positive? Add its fingerprint to .gitleaksignore." >&2
  exit 1
fi
