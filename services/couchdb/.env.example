# CouchDB Configuration
#
# Password policy: this one gets typed by hand in the LiveSync plugin on every
# device, so use a word-based passphrase (6 common words + 2 digits, ~62 bits)
# rather than random characters — easy on a phone keyboard, still strong.
# Generate the rest of your service passwords randomly in Vaultwarden instead.

COUCHDB_PORT=5984
COUCHDB_USER=peciulevicius
COUCHDB_PASSWORD=change_me_six_common_words_plus_digits
