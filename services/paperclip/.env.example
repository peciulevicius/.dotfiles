# Paperclip configuration — copy to .env (setup-services.sh does this once).
# Never commit real values; the live file is ~/services/paperclip/.env.

PAPERCLIP_PORT=3100
# Optional local image fixing the unchanged-binding comparison (README).
# PAPERCLIP_IMAGE=paperclip-homelab:2026.916.1-binding-order
PAPERCLIP_PUBLIC_URL=http://100.81.171.49:3100
# Extra hostnames the instance accepts, comma-separated (the MagicDNS name).
PAPERCLIP_ALLOWED_HOSTNAMES=localhost,127.0.0.1,100.81.171.49,<macmini>.<tailnet>.ts.net,paperclip,host.docker.internal

# Session-signing secret. Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=change_me_openssl_rand_hex_32

# Signs approved tool-action writes (e.g. a Coach agent updating TrainingPeaks
# after you approve a decision). Only auto-generated for Paperclip's internal
# worktree feature, NOT for the main instance — missing this silently blocks
# every signed write with "PAPERCLIP_TOOL_ACTION_SIGNING_SECRET is not
# configured" (found 2026-09-29, blocked TrainingPeaks writes from day one).
# Generate: openssl rand -hex 32
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=change_me_openssl_rand_hex_32

# Set to true after the first admin has claimed the instance.
PAPERCLIP_AUTH_DISABLE_SIGN_UP=false

# First admin — reference copy only (Paperclip does not read these).
# Move to Vaultwarden, then delete these two lines.
# PAPERCLIP_ADMIN_EMAIL=
# PAPERCLIP_ADMIN_PASSWORD=

# ── Agent credentials (optional; leave commented until you add an agent) ──
# Claude Code on a Pro/Max subscription: run `claude setup-token` on the host.
# CLAUDE_CODE_OAUTH_TOKEN=
# Or pay-as-you-go API billing instead:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
