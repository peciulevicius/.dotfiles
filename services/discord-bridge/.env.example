# Discord bot token (Developer Portal → your app → Bot → Reset Token).
# Needs the "Message Content" privileged intent enabled.
DISCORD_BOT_TOKEN=
# Your Discord user ID (Settings → Advanced → Developer Mode, then right-click
# your name → Copy User ID). Only this user's messages are relayed.
DISCORD_OWNER_ID=
# Paperclip board login (same account as the UI).
PAPERCLIP_URL=http://paperclip:3100
PAPERCLIP_EMAIL=
PAPERCLIP_PASSWORD=
PAPERCLIP_COMPANY_ID=31472664-4bfe-4bd1-9313-19d0739378d2
# channelId:agentId:AgentName, comma-separated. AgentName is used for the
# @mention that wakes the agent, so it must match the Paperclip agent name.
CHANNEL_MAP=
POLL_SECONDS=30
