# Discord bot token (Developer Portal → your app → Bot → Reset Token).
# Needs the "Message Content" privileged intent enabled.
DISCORD_BOT_TOKEN=
# Optional. Only this Discord user's messages are relayed. Empty = the owner
# of the bot application (i.e. whoever created the bot).
DISCORD_OWNER_ID=
# Paperclip board login (same account as the UI).
PAPERCLIP_URL=http://paperclip:3100
PAPERCLIP_EMAIL=
PAPERCLIP_PASSWORD=
# Base URL for the "Open in Paperclip" link buttons (must work from your phone).
PAPERCLIP_LINK_BASE=http://100.81.171.49:3100
# channelId:agentId:AgentName, comma-separated. AgentName is used for the
# @mention that wakes the agent, so it must match the Paperclip agent name.
CHANNEL_MAP=
# Optional: companyId:channelId,... — where decisions with no obvious agent channel go.
# Default: the first mapped channel of that company.
NOTIFY_CHANNELS=
POLL_SECONDS=30
