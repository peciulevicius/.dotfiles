# Vaultwarden Configuration
#
# ADMIN_TOKEN must be an Argon2 PHC hash, not plaintext. Generate one:
#   openssl rand -base64 36                                   # the token you'll type
#   docker run --rm -it vaultwarden/server:1.35.4 \
#     /vaultwarden hash --preset owasp                        # paste it twice
#
# Put the resulting $argon2id$... string here in SINGLE QUOTES, with single $
# characters exactly as printed. ⚠️ Do NOT double the $ — that rule applies to
# values written inside docker-compose.yml, not to a .env file. Verified by
# test: .env values are passed through verbatim.
# Log into /admin with the random token, never the hash.

VW_PORT=8001
ADMIN_TOKEN='change_me_argon2_phc_string'
# Use Cloudflare Tunnel URL for HTTPS (required for Bitwarden apps)
# Run: scripts/setup/setup-cloudflare-tunnel.sh
DOMAIN=https://vault.yourdomain.com
SIGNUPS_ALLOWED=false

# Behind Cloudflare Tunnel: without this every client is logged as the same
# bogus IP, making login rate-limiting global and logs useless.
IP_HEADER=CF-Connecting-IP

# warn by default; set to debug to diagnose a login problem
LOG_LEVEL=warn
EXTENDED_LOGGING=true
