# Odysseus Configuration
# Generate ODYSSEUS_ADMIN_PASSWORD: openssl rand -base64 32
#
# Odysseus builds from source, so its own repo must be cloned first:
#   ~/.dotfiles/services/odysseus/setup.sh

# ⚠️ 7000 is taken by macOS AirPlay Receiver — upstream's own docs warn about it
APP_PORT=7001
# 0.0.0.0 so Tailscale can reach it, consistent with the other services here.
# AUTH_ENABLED is the actual gate.
APP_BIND=0.0.0.0

AUTH_ENABLED=true
LOCALHOST_BYPASS=false
ODYSSEUS_ADMIN_USER=peciulevicius
ODYSSEUS_ADMIN_PASSWORD=change_me_generate_in_vaultwarden

# Native Ollama on the host (Homebrew, Metal-accelerated).
# ⚠️ NEVER run the model inside Docker — no GPU passthrough on macOS.
# Requires ollama listening on 0.0.0.0: OLLAMA_HOST=0.0.0.0:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# macOS host user (id -u / id -g), or bind-mounted files end up root-owned
PUID=501
PGID=20

# Bundled services stay loopback-only
CHROMADB_BIND=127.0.0.1
NTFY_BIND=127.0.0.1
