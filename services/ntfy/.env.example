# ntfy configuration — copy to .env (setup-services.sh does this once).
# Never commit real values; the live file is ~/services/ntfy/.env.

NTFY_PORT=8095
NTFY_BASE_URL=http://100.81.171.49:8095

# ── Reference only — ntfy itself doesn't read these, they document what's in
#    the auth database (./data/auth/auth.db) so the value isn't only in your
#    head. Fill in after running the `ntfy user add` / `ntfy token add` steps
#    in README.md. Never commit real values.
#
# Private topic name (random suffix so it can't be guessed/subscribed to):
#   openssl rand -hex 4
# NTFY_TOPIC=coach-changeme
#
# Publish token — bound to a user with write-only access to NTFY_TOPIC.
# This is the value that becomes the Paperclip secret for the Coach agent.
# NTFY_PUBLISH_TOKEN=
#
# Read token — bound to a user with read-only access to NTFY_TOPIC.
# This is the value the phone's ntfy app uses to subscribe.
# NTFY_READ_TOKEN=
