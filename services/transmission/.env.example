# Transmission Configuration

TRANSMISSION_PORT=9091
TRANSMISSION_USER=admin
TRANSMISSION_PASS=changeme
TZ=Europe/Vilnius
PUID=1000
PGID=1000

# Downloads go to the shared media directory
MEDIA_DIR=/Volumes/media

# Tailscale sidecar (transmission-ts). Generate at
# https://login.tailscale.com/admin/settings/keys — single-use, pre-approved.
# Only used on first login; the node identity then persists in ./data/tailscale,
# so the key can be left spent (or removed) afterwards.
TS_AUTHKEY=
