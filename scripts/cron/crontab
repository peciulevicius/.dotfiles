PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin

# Every job runs through run-with-notify.sh, which pings Discord when a job
# starts failing and again when it recovers. Configure the webhook in
# ~/.config/homelab/notify.env — without it the wrapper is a silent no-op.

# Image updates (services/wud; replaced the quarterly check-image-updates.py
# review 2026-09-28). Daily after WUD's 06:00 registry check: refresh the
# Glance "Updates" widget. Mondays 09:00: weekly summary to Discord.
# Upgrading is manual and one command: scripts/utils/upgrade-service.sh.
30 6 * * * ~/.dotfiles/scripts/utils/update-report.sh >> ~/logs/update-report.log 2>&1
0 9 * * 1 ~/.dotfiles/scripts/utils/update-report.sh --discord >> ~/logs/update-report.log 2>&1
# External dead-man's switch: ping Healthchecks.io every 5 minutes. Not wrapped
# in run-with-notify — the alert for this one comes from outside the network.
*/5 * * * * ~/.dotfiles/scripts/utils/heartbeat.sh >> ~/logs/heartbeat.log 2>&1
# Glance "Homelab health" widget: host-side snapshot (memory, swap, disk,
# backup ages, sleepers awake, Paperclip queue, Dietitian's line for today)
# → ~/services/glance/assets/status.json. Not wrapped in run-with-notify —
# a stale "updated" time on the homepage is the signal.
*/5 * * * * ~/.dotfiles/scripts/utils/homelab-status.sh >> ~/logs/homelab-status.log 2>&1
*/5 * * * * ~/.dotfiles/scripts/utils/calendar-status.sh >> ~/logs/calendar-status.log 2>&1
# Glance Finance "Portfolio" widget: IBKR + Trading 212 + Kraken (read-only)
# → ~/services/glance/assets/finance.json. Provider-specific caches keep API
# use low. The next job writes a private daily summary to ~/ai-memory/finance.
0 7 * * * ~/.dotfiles/scripts/utils/finance-status.sh >> ~/logs/finance-status.log 2>&1
5 7 * * * ~/.dotfiles/scripts/utils/finance-memory-snapshot.sh >> ~/logs/finance-memory-snapshot.log 2>&1

# Weekly database dumps (Sunday 4am)
0 4 * * 0 ~/.dotfiles/scripts/utils/run-with-notify.sh "DB backup" ~/.dotfiles/scripts/backup/backup-databases.sh >> ~/logs/db-backup.log 2>&1

# rclone backup nightly at 5AM, after Immich and DB backups.
# ⚠️ Runs the STAGED copy in ~/services/rclone/ so it reads ~/services/rclone/.env
# — the repo copy read a second, stale .env and silently skipped the Immich
# photo backup until 2026-09-23. See README.md.
# Shared AI memory (~/ai-memory): auto-commit agent edits to its local git repo every 15 min.
*/15 * * * * ~/.dotfiles/scripts/utils/ai-memory-commit.sh >> ~/logs/ai-memory.log 2>&1
0 5 * * * ~/.dotfiles/scripts/utils/run-with-notify.sh "Cloud backup (R2)" ~/services/rclone/rclone-backup.sh >> ~/logs/rclone-backup.log 2>&1

# Kindle Scribe → Obsidian: check for new export emails every hour
0 * * * * ~/.dotfiles/scripts/utils/run-with-notify.sh "Kindle sync" ~/.dotfiles/pkm/.venv/bin/python3 ~/.dotfiles/pkm/kindle_sync.py >> ~/logs/kindle-sync.log 2>&1

# R2 restore spot-check (1st of the month, 6am, after the 5am backup) —
# downloads one random file per backup set and byte-compares it with the original
0 6 1 * * ~/.dotfiles/scripts/utils/run-with-notify.sh "R2 restore check" ~/.dotfiles/scripts/backup/r2-verify.sh >> ~/logs/r2-verify.log 2>&1

# The Jellyfin/Audiobookshelf SMB rescan restart was removed 2026-09-28:
# it woke Sablier sleepers and interrupted playback. Manual helper only.

# Weekly homelab audit (Sunday 9am) — drift, containers, backups, disk, secrets
0 9 * * 0 ~/.dotfiles/scripts/utils/run-with-notify.sh "Homelab audit" ~/.dotfiles/scripts/utils/homelab-audit.sh >> ~/logs/homelab-audit.log 2>&1

# Paperclip reports feed (Sunday 9:30, after the audit) — read-only snapshot
# into ~/services/paperclip/reports, mounted :ro at /reports in the container.
# The Homelab company's weekly routine reads it at 10:00. No secrets go in.
30 9 * * 0 ~/.dotfiles/scripts/utils/run-with-notify.sh "Paperclip reports" ~/.dotfiles/scripts/utils/paperclip-reports.sh >> ~/logs/paperclip-reports.log 2>&1
# Paperclip usage-limit watchdog (every 5 min). AUTO_SWITCH is OFF again
# (2026-09-29, same day — a real limit hit fired it and it switched 10
# agents across all 3 companies to OpenRouter, then Paperclip's restore bug
# hit ALL of them, not just one: broken org-chart manager references, lost
# skill attachments, and a stale Discord-bridge agent ID. Fixed by hand;
# details + the exact manual recipe: services/paperclip/README.md →
# "Usage-limit fallback". Re-enable only once restore does a proper
# pause+rehire (with manager/skill/issue remap) instead of a bare PATCH.
*/5 * * * * ~/.dotfiles/scripts/utils/paperclip-fallback.sh >> ~/logs/paperclip-fallback.log 2>&1
# Monthly: remind to check prepaid AI credits + subscriptions (list lives privately in the Obsidian vault)
0 10 1 * * /bin/bash -c 'source ~/.dotfiles/scripts/lib/notify.sh && notify_discord "💳 Monthly money check" "Check prepaid balances (OpenRouter, Anthropic console, Codex usage) and update Obsidian → 💰 Finance/Subscriptions & Credits." info reminders' >> ~/logs/monthly-reminder.log 2>&1
